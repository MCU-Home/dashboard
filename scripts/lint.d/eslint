#
# eslint, via pnpm's lint script. A missing pnpm or a missing
# frontend/node_modules is a failure, never a silent skip. Extra
# arguments are passed through. See CONTRIBUTING.md ("Repository
# layout").
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "lint.d/eslint: pnpm not found on PATH. Install Node 22 and pnpm first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

if [ ! -d "$root/frontend/node_modules" ]; then
  echo "lint.d/eslint: no frontend/node_modules found. Install it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

cd "$root/frontend"
exec pnpm run lint "$@"
