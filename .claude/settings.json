{
  "permissions": {
    "allow": [
      "Bash(ruff:*)",
      "Bash(pytest:*)",
      "Bash(pre-commit:*)",
      "Bash(reuse:*)",
      "Bash(npm run:*)"
    ],
    "deny": [
      "Read(/.env)",
      "Read(/.env.*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Bash(npm publish:*)"
    ]
  }
}
