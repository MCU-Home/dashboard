#!/usr/bin/env bash
# SPDX-FileCopyrightText: 2026 The MCUHome Contributors
# SPDX-License-Identifier: Apache-2.0
#
# vitest, via pnpm, from the frontend's own installed dependencies. A
# missing pnpm or a missing frontend/node_modules is a failure, never a
# silent skip. Extra arguments are passed through. See CONTRIBUTING.md
# ("Repository layout").
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if ! command -v pnpm >/dev/null 2>&1; then
  echo "test.d/vitest: pnpm not found on PATH. Install Node 22 and pnpm (see README)." >&2
  exit 1
fi

if [ ! -d "$root/frontend/node_modules" ]; then
  echo "test.d/vitest: no frontend/node_modules found. Install it first: (cd frontend && pnpm install --frozen-lockfile) (see README)." >&2
  exit 1
fi

cd "$root/frontend"
exec pnpm exec vitest run "$@"
