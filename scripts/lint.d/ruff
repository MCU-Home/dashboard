#
# ruff check and ruff format --check over backend and docker, from this
# repository's own .venv — the same paths the README has always run
# this over. Extra arguments are passed through to both. See
# CONTRIBUTING.md ("Repository layout").
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"
venv="$root/.venv"

if [ ! -x "$venv/bin/ruff" ]; then
  echo "lint.d/ruff: no .venv found. Create it first — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

cd "$root"
status=0
"$venv/bin/ruff" check backend docker "$@" || status=$?
"$venv/bin/ruff" format --check backend docker "$@" || status=$?
exit "$status"
