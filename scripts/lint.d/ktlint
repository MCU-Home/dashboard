#
# ktlint over the front end's Kotlin sources and Gradle build scripts,
# run through the Gradle wrapper checked in with the sources. Checks
# only — `cd frontend && ./gradlew ktlintFormat` is what fixes what can
# be fixed automatically. The rules come from the repository's
# .editorconfig; the ktlint version is pinned in
# frontend/gradle/libs.versions.toml.
#
# Extra arguments are passed through to Gradle.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)"

if ! command -v java >/dev/null 2>&1; then
  echo "lint.d/ktlint: no Java found. Install a JDK 21 — see README, \"Development — how to work on this repository\"." >&2
  exit 1
fi

cd "$root/frontend"
exec ./gradlew --console=plain ktlintCheck "$@"
