{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["vite/client"],

    "strict": true,
    "noImplicitOverride": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "noUncheckedIndexedAccess": true,

    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",

    // Lit 3 with TypeScript's legacy decorators, which is what Home
    // Assistant's and ESPHome's frontends run (ADR 0005). Standard
    // decorators would need `accessor` on every reactive property and
    // buy nothing here. `useDefineForClassFields` must stay false for
    // them: class fields defined with [[Define]] semantics overwrite the
    // accessors Lit installs, and every property silently stops
    // reacting.
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": ["src", "test"]
}
